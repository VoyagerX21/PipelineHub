# Application Environment
NODE_ENV=production
PORT=3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/pipelinehub
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://default:password@host:port

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_here
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# URLs & Domains
FRONTEND_URL=https://your-frontend-app.com
BACKEND_URL=https://pipelinehub.khakse.dev
PUBLIC_DOMAIN=https://pipelinehub.khakse.dev

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitLab OAuth App
GITLAB_CLIENT_ID=your_gitlab_client_id
GITLAB_CLIENT_SECRET=your_gitlab_client_secret
GITLAB_REDIRECT_URI=https://pipelinehub.khakse.dev/auth/gitlab/callback

# Bitbucket OAuth Consumer
BITBUCKET_CLIENT_ID=your_bitbucket_client_id
BITBUCKET_CLIENT_SECRET=your_bitbucket_client_secret
BITBUCKET_REDIRECT_URI=https://pipelinehub.khakse.dev/auth/bitbucket/callback

# EmailJS Configuration (Password Reset)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=service_2gjyb8j
EMAILJS_TEMPLATE_ID=template_ppd75xv